
<li>
  <article class="reis-kaart">
    <img class="reis-afbeelding" src="<%= data.reis.afbeelding %>" alt="<%= data.reis.afbeeldingAlt %>">

    <h3><%= data.reis.titel %></h3>
  
    <ul class="reis-eigenschappen">
       <% data.reis.eigenschappen.forEach(function (eigenschap) { %> 
           <li><%= eigenschap %></li> 
       <% }) %>
    </ul>


   <div class="beheerder-reis">
      <img src="<%= data.reis.beheerder.foto %>" alt="Profielfoto van <%= data.reis.beheerder.naam %>">
      <p><%= data.reis.beheerder.naam %></p>
   </div>

  </article>
</li>
