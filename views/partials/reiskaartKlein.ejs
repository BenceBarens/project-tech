<li class="reiskaartKlein">
   <a href="/reis/<%= reis._id %>">
      <article>
            <img src="/uploads/coverfoto/<%= reis.fotoPad %>" alt="Foto van <%= reis.titel %>">
            <div>
                <h3><%= reis.reisTitel %></h3>
                <p><%= reis.bestemmingen %></p>
                <ul class="chipsInfo">
                    <li><%= reis.aantalDagen %> dagen</li>
                    <li><%= reis.bedragen %></li>
                    <li><%= reis.reizen %></li>
                    <li><%= reis.verblijf %></li>
                    <li><%= reis.minLeeftijd %> tot <%= reis.maxLeeftijd %> jaar oud</li>
                </ul>
            </div>
      </article>
   </a>
</li>