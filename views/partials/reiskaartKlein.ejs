
<li>
  <article class="reis-kaart">
    <img class="reis-afbeelding" src="<%= reis.afbeelding %>" alt="<%= reis.afbeeldingAlt %>">

    <h3><%= reis.titel %></h3>
  
    <ul class="reis-eigenschappen">
       <% reis.eigenschappen.forEach(function (eigenschap) { %> 
           <li><%= eigenschap %></li> 
       <% }) %>
    </ul>


   <div class="beheerder-reis">
      <img src="<%= reis.beheerder.foto %>" alt="Profielfoto van <%= reis.beheerder.naam %>">
      <p><%= reis.beheerder.naam %></p>
   </div>

  </article>
</li>