<li class="reiskaartKlein">
    <a href="/reis/<%= reis._id %>">
        <article>
            <% if (reis.fotoPad) { %>
                <img src="/uploads/coverfoto/<%= reis.fotoPad %>" alt="Foto van <%= reis.titel %>">
            <% } %>

            <div>
                <% if (reis.reisTitel) { %>
                    <h3><%= reis.reisTitel %></h3>
                <% } %>

                <% if (reis.bestemmingen) { %>
                    <p><%= reis.bestemmingen %></p>
                <% } %>

                <ul class="chipsInfo">
                    <% if (reis.aanvragenLijst && reis.aanvragenLijst.length > 0) { %>
                        <li><%= reis.aanvragenLijst.length %> nieuwe aanvragen</li>
                    <% } %>
                    
                    <% if (reis.aantalDagen) { %>
                        <li><%= reis.aantalDagen %> dagen</li>
                    <% } %>

                    <% if (reis.bedragen) { %>
                        <li><%= reis.bedragen %></li>
                    <% } %>

                    <% if (reis.reizen) { %>
                        <li><%= reis.reizen %></li>
                    <% } %>

                    <% if (reis.minLeeftijd && reis.maxLeeftijd) { %>
                        <li><%= reis.minLeeftijd %> tot <%= reis.maxLeeftijd %> jaar oud</li>

                    <% } else if (reis.minLeeftijd) { %>
                        <li>Vanaf <%= reis.minLeeftijd %> jaar oud</li>

                    <% } else if (reis.maxLeeftijd) { %>
                        <li>Tot <%= reis.maxLeeftijd %> jaar oud</li>
                    <% } %>
                </ul>
            </div>
        </article>
    </a>
</li>