<li class="reizigersKaart">
    <a href="/profiel/<%= data.gebruiker._id %>">
        <img src="<%= data.gebruiker.profielfoto %>" alt="Profielfoto van <%= data.gebruiker.voornaam %>">
        <div>
            <p><strong><%= data.gebruiker.voornaam %> <%= data.gebruiker.achternaam %></strong></p>
            <p><%= data.status %></p>
        </div>
    </a>

    <% if (data.toonContact) { %>
        <div class="contactGegevens">
            <a href="mailto:<%= data.gebruiker.email %>">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <%= data.gebruiker.email %>
            </a>
            <% if (data.gebruiker.telefoonNummer) { %>
                <a href="tel:<%= data.gebruiker.telefoonNummer %>">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.81 12.81 0 0 0 .63 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.63A2 2 0 0 1 22 16.92z"></path></svg>
                    <%= data.gebruiker.telefoonNummer %>
                </a>
            <% } %>
        </div>
    <% } %>

    <% if (data.status === "Aangevraagd") { %>
        <div class="aanvraag">
            <button type="button" class="button aanvraag-accepteren" data-reis-id="<%= data.reisId %>" data-gebruiker-id="<%= data.gebruiker._id %>">
                Accepteren
            </button>
            <button type="button" class="button2 aanvraag-weigeren" data-reis-id="<%= data.reisId %>" data-gebruiker-id="<%= data.gebruiker._id %>">
                Weigeren
            </button>
        </div>
    <% } %>
</li>