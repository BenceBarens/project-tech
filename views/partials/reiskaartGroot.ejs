<li class="reiskaartGroot" data-reis-id="<%= data.reis._id %>">
    <article>
        <img src="/uploads/coverfoto/<%= data.reis.fotoPad %>" alt="<%= data.reis.reisTitel %>">
        <div class="reiskaartInhoud">
            <h2><%= data.reis.reisTitel %></h2>
            <p>
                Tussen 
                <b><time datetime="<%= data.reis.startDatum %>">
                    <%= new Date(data.reis.startDatum).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                </time></b>
                en 
                <b><time datetime="<%= data.reis.eindDatum %>">
                    <%= new Date(data.reis.eindDatum).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                </time></b>
                voor een periode van <b><%= data.reis.aantalDagen %></b> dagen.
            </p>

            <ul class="chipsInfo">
                <% if (data.reis.bedragen) { %><li><%= data.reis.bedragen %></li><% } %>
                <% if (data.reis.reizen) { %><li><%= data.reis.reizen %></li><% } %>
                
                 <% if (data.reis.verblijf) { %>
                    <li>
                        <% if (Array.isArray(data.reis.verblijf)) { %>
                            <%= data.reis.verblijf.join(', ') %>
                        <% } else { %>
                            <%= data.reis.verblijf %>
                        <% } %>
                    </li>
                <% } %>
                
                <% if (data.reis.minLeeftijd && data.reis.maxLeeftijd) { %>
                    <li><%= data.reis.minLeeftijd %> tot <%= data.reis.maxLeeftijd %> jaar oud</li>

                <% } else if (data.reis.minLeeftijd) { %>
                    <li>Vanaf <%= data.reis.minLeeftijd %> jaar oud</li>

                <% } else if (data.reis.maxLeeftijd) { %>
                    <li>Tot <%= data.reis.maxLeeftijd %> jaar oud</li>
                <% } %>
              
                <!-- toevoegen van , en spatie bij Array--> 
                <% if (data.reis.geslacht) { %>
                    <li>
                        <% if (Array.isArray(data.reis.geslacht)) { %>
                            <%= data.reis.geslacht.join(', ') %>
                        <% } else { %>
                            <%= data.reis.geslacht %>
                        <% } %>
                    </li>
                <% } %>
            </ul>

            <p><%= data.reis.reis_samenvatting %></p>
            
            <h3>Reizigers</h3>
            <p>Capaciteit: <%= data.reis.minReizigers %> tot <%= data.reis.maxReizigers %> reizigers in totaal</p>

            <ul id="deelnemers">
                <% if (data.reis.organisator) { %>
                    <%- include('reiziger', { 
                        data: { 
                            gebruiker: data.reis.organisator,
                            status: "Organisator" 
                        } 
                    }) %>
                <% } %>

                <% if (data.reis.deelnemersLijst && data.reis.deelnemersLijst.length > 0) { %>
                    <% data.reis.deelnemersLijst.forEach(function(deelnemer) { %>
                        <%- include('reiziger', { 
                            data: { 
                                gebruiker: deelnemer,
                                status: "Deelnemer" 
                            } 
                        }) %>
                    <% }) %>
                <% } %>
            </ul>

            <div>
                <input type="checkbox" id="reisUitklappen" name="Meer lezen">
                <label for="reisUitklappen" class="button2">Meer lezen</label>
                <p><%= data.reis.reis_beschrijving %></p>
            </div>
        </div>
    </article>
</li>