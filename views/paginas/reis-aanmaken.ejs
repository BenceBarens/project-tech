<% layout('layouts/boilerplate') %>
<div>

</div>

<main id="main" class="reisAanmaken">
    <h1>Start een nieuw avontuur</h1>
    <form action="/nieuwe-reis" method="POST" enctype="multipart/form-data">

        <fieldset id="stap1">
            <legend>Laten we een reis aanmaken! (1/8)</legend>
            <label for="reisTitel">Geef jouw reis een naam*</label>
            <input type="text" id="reisTitel" name="reisTitel" placeholder="Stedentrip door Zuid-Europa" required oninvalid="this.setCustomValidity('Geef je reis een titel')" oninput="this.setCustomValidity('')">

            <label for="reisFoto" class="dropzone" id="dropzone">
                <input type="file" id="reisFoto" name="reisFoto" accept="image/*" required oninvalid="this.setCustomValidity('Kies een coverfoto voor je reis')" oninput="this.setCustomValidity('')">
            
                <div class="dropzone-content" id="dropzone-text">
                    <svg class="upload-icon" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                        <circle cx="12" cy="13" r="4"></circle>
                    </svg>
                    <p>Sleep een foto hiernaartoe of <strong>klik om te uploaden*</strong></p>
                    <small>PNG, JPG of JPEG (max. 5MB)</small>
                </div>
                
                <img id="image-preview" src="" alt="Preview van de coverfoto" class="hidden">
            </label>

            <div class="formNav">
                <a href="#stap2" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap2">
            <legend>Duur van de reis (2/8)</legend>

            <label for="start-datum">Vanaf wanneer wil je weg?*</label>
            <input type="date" id="start-datum" name="startDatum" min="2026-03-25" required oninvalid="this.setCustomValidity('Je mist nog een start datum.')" oninput="this.setCustomValidity('')"><br>
            <label for="eind-datum">Wanneer wil je uiterlijk weer terug zijn?*</label>
            <input type="date" id="eind" name="eindDatum" min="2026-03-25" required oninvalid="this.setCustomValidity('Je mist nog een eind datum.')" oninput="this.setCustomValidity('')"><br>

            <label for="aantalDagen">In totaal wil ik ongeveer <input type="number" id="aantalDagen" name="aantalDagen" min="2" max="365" required oninvalid="this.setCustomValidity('Geef nog aan hoe lang je weg zou willen')" oninput="this.setCustomValidity('')"> dagen weg*</label>

            <div class="formNav">
                <a href="#stap1" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap3" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap3">
            <legend>Beschrijving (3/8)</legend>
            <label for="reis-beschrijving">Beschrijf jouw reis. Wat wil je doen, wat zijn de plannen?</label><br>
            <textarea id="reis-beschrijving" name="reis_beschrijving" placeholder="Typ hier een beschrijving"></textarea><br>

            <label for="reis-samenvatting">Geef een samenvatting van jouw reis*</label>
            <input type="text" id="reis-samenvatting" name="reis_samenvatting" placeholder="Typ hier een beschrijving" maxlength="50" required oninvalid="this.setCustomValidity('Geef je reis nog een korte samenvatting!')" oninput="this.setCustomValidity('')">

            <div class="formNav">
                <a href="#stap2" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap4" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap4">
            <legend>Waar gaat jouw reis naar toe? (4/8)</legend>
            <p>Voeg de steden of landen toe die jij graag zou willen bezoeken</p>

            <input type="text" id="locatie-zoeken" placeholder="Zoek een bestemming" autocomplete="off">
            <div><ul id="gekozen-locaties-container"></ul><ul id="suggestie-lijst"></ul></div>
            
            <div class="formNav">
                <a href="#stap3" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap5" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap5">
            <legend>Wat wordt het budget voor de reis? (5/8)</legend>

            <label class="chipRadio"><input type="radio" id="bedrag1" name="bedragen" value="bedrag1">€0 tot €500</label>
            <label class="chipRadio"><input type="radio" id="bedrag2" name="bedragen" value="bedrag2">€500 tot €1K</label>
            <label class="chipRadio"><input type="radio" id="bedrag3" name="bedragen" value="bedrag3">€1K tot €1.5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag4" name="bedragen" value="bedrag4">€1.5K tot €2.5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag5" name="bedragen" value="bedrag5">€2.5K tot €5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag6" name="bedragen" value="bedrag6">Meer dan €5K</label>

            <div class="formNav">
                <a href="#stap4" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap6" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap6">
            <legend>Over jouw medereizigers (6/8)</legend>

            <p>Met hoeveel mensen zou je weg willen?</p>
            <label for="minReizigers">Minimum</label>
            <input type="number" id="minReizigers" name="minReizigers" min="1">

            <label for="maxReizigers">Maximum</label>
            <input type="number" id="maxReizigers" name="maxReizigers" min="2">

            <p>Welke leeftijd mogen je medereizigers zijn?</p>
            <label for="minLeeftijd">Minimum</label>
            <input type="number" id="minLeeftijd" name="minLeeftijd" min="18">

            <label for="maxLeeftijd">Maximum</label>
            <input type="number" id="maxLeeftijd" name="maxLeeftijd" min="19">

            <p>Geslacht medereizigers (meerdere opties mogelijk)</p>
            <label class="chipToggle"><input type="checkbox" id="vrouwen" name="geslacht" value="vrouwen">Vrouwen</label>
            <label class="chipToggle"><input type="checkbox" id="mannen" name="geslacht" value="mannen">Mannen</label>
            <label class="chipToggle"><input type="checkbox" id="anders" name="geslacht" value="anders">Anders</label>

            <div class="formNav">
                <a href="#stap5" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap7" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap7">
            <legend>Type reis (7/8)</legend>

            <p>Wat voor soort reis gaat het worden?*</p>

            <label class="chipRadio"><input type="radio" id="reis-optie1" name="reizen" value="reis-optie1" required oninvalid="this.setCustomValidity('Kies een van de opties voor het type reis.')" oninput="this.setCustomValidity('')">Rondreis (en overig)</label>
            <label class="chipRadio"><input type="radio" id="reis-optie2" name="reizen" value="reis-optie2">Resort</label>
            <label class="chipRadio"><input type="radio" id="reis-optie3" name="reizen" value="reis-optie3">Wintersport</label>
            <label class="chipRadio"><input type="radio" id="reis-optie4" name="reizen" value="reis-optie4">Camping</label>
            <label class="chipRadio"><input type="radio" id="reis-optie5" name="reizen" value="reis-optie5">City trip</label>
            <label class="chipRadio"><input type="radio" id="reis-optie6" name="reizen" value="reis-optie6">Safari</label>

            <p>Wat lijkt jou leuk om te doen tijdens de reis? (Meerdere opties mogelijk)</p>

            <label class="chipToggle"><input type="checkbox" id="wandelen" name="activiteit" value="wandelen">Wandelen</label>
            <label class="chipToggle"><input type="checkbox" id="fietsen" name="activiteit" value="fietsen">Fietsen</label>
            <label class="chipToggle"><input type="checkbox" id="zwemmen" name="activiteit" value="zwemmen">Zwemmen</label>
            <label class="chipToggle"><input type="checkbox" id="museau-bezoeken" name="activiteit" value="musea bezoeken">Musea bezoeken</label>
            <label class="chipToggle"><input type="checkbox" id="ontdekken" name="activiteit" value="ontdekken">Ontdekken</label>

            <div class="formNav">
                <a href="#stap6" role="button" tabindex="-1" class="button2">Vorige</a>
                <a href="#stap8" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
            </div>
        </fieldset>

        <fieldset id="stap8">
            <legend>Waar wil je overnachten? (8/8)</legend>
            <p>Laat mede reizigers weten wat jouw voorkeur van verblijf is (meerdere opties mogelijk)</p>

            <label class="chipToggle"><input type="checkbox" id="hotel" name="verblijf" value="hotel">Hotel</label>
            <label class="chipToggle"><input type="checkbox" id="motel" name="verblijf" value="motel">Motel</label>
            <label class="chipToggle"><input type="checkbox" id="caravan/camper" name="verblijf" value="caravan/camper">Caravan/camper</label>
            <label class="chipToggle"><input type="checkbox" id="b&b" name="verblijf" value="b&b">Bed & breakfast B&B</label>
            <label class="chipToggle"><input type="checkbox" id="tent" name="verblijf" value="tent">Tent</label>

            <div class="formNav">
                <a href="#stap7" role="button" tabindex="-1" class="button2">Vorige</a>
                <input type="submit" value="Afronden" class="button btn-volgende">
            </div>
        </fieldset>
    </form>
</main>
<script src="/js/locatie-zoeker.js"></script>
<script src="/js/foutmeldingen.js"></script>
<script src="/js/upload-preview.js"></script>