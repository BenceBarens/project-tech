<% layout('layouts/boilerplate') %>
<div>
    <a href="/profiel" class="button2">Annuleren</a>
</div>
<main id="main" class="profielBewerken">
    <h1>Instellingen</h1>
    
    <form action="/profiel/bewerken" method="POST" enctype="multipart/form-data">
        <fieldset>
            <legend>Persoonlijke info</legend>
            <label>
                Profielfoto (Klik om te uploaden)
                <div id="preview-wrapper">
                    <img id="image-preview" src="<%= data.gebruiker.profielfoto %>" alt="Profielfoto van <%= data.gebruiker.voornaam %>">
                </div>
                <input type="file" accept="image/*" id="profielfoto" name="profielfoto">
            </label>
            <div>
                <div>
                    <label for="voornaam">Voornaam</label>
                    <input type="text" id="voornaam" name="voornaam" value="<%= data.gebruiker.voornaam %>" required oninvalid="this.setCustomValidity('Vul je voornaam in.')">
                    <label for="achternaam">Achternaam</label>
                    <input type="text" id="achternaam" name="achternaam" value="<%= data.gebruiker.achternaam %>" required oninvalid="this.setCustomValidity('Vul je achternaam in.')">
                </div>
                <div>
                    <label for="bio">Over mij (bio)</label><br>
                    <textarea id="bio" name="bio"><%= data.gebruiker.bio || '' %></textarea>
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Gegevens</legend>
            <div>
                <label for="email">Email</label><br>
                <input type="email" id="email" name="email" value="<%= data.gebruiker.email %>" required oninvalid="this.setCustomValidity('Vul je e-mailadres in.')">
            </div>

            <div>
                <label for="geslacht">Geslacht</label><br>
                <select id="geslacht" name="geslacht" required>
                    <option value="Vrouw" <%= data.gebruiker.geslacht === 'Vrouw' ? 'selected' : '' %>>Vrouw</option>
                    <option value="Man" <%= data.gebruiker.geslacht === 'Man' ? 'selected' : '' %>>Man</option>
                    <option value="Anders" <%= data.gebruiker.geslacht === 'Anders' ? 'selected' : '' %>>Anders</option>
                </select>
            </div>

            <div>
                <label for="woonplaats">Woonplaats</label><br>
                <input type="text" id="woonplaats" name="woonplaats" value="<%= data.gebruiker.woonplaats || '' %>">
            </div>

        </fieldset>

        <fieldset>
            <legend>Wachtwoord wijzigen</legend>
            <p>Laat leeg als je je wachtwoord niet wilt veranderen.</p>

            <div>
                <label for="huidigWachtwoord">Huidig wachtwoord</label><br>
                <input type="password" id="huidigWachtwoord" name="huidigWachtwoord" placeholder="Huidige wachtwoord" minlength="8">
            </div>
            <div>
                <label for="nieuwWachtwoord">Nieuw wachtwoord</label><br>
                <input type="password" id="nieuwWachtwoord" name="nieuwWachtwoord" placeholder="Nieuwe wachtwoord" minlength="8">
            </div>
        </fieldset>

        <button type="submit" class="button">Wijzigingen opslaan</button> <a href="/profiel" class="button2">Annuleren</a>
    </form>
</main>

<script src="/js/profielfoto-preview.js"></script>