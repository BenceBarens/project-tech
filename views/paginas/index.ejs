<% layout('layouts/boilerplate') %>
<div class="homeDiv">
    <label for="filtersUitklappen">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M22 3H2L10 12.46V19L14 21V12.46L22 3Z" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Zoekfilters
    </label>
</div>

<main class="home" id="main">
    <section>
        <input type="checkbox" id="filtersUitklappen" name="Zoekfilters">
        <form method="GET" action="/">
            <fieldset>
                <legend>Budget range</legend>
                <label class="chipToggle"><input type="checkbox" id="budget1" value="bedrag1" name="bedragen" <%= data.filters.bedragen.includes('bedrag1') ? 'checked' : '' %>> €0 tot €500</label>
                <label class="chipToggle"><input type="checkbox" id="budget2" value="bedrag2" name="bedragen" <%= data.filters.bedragen.includes('bedrag2') ? 'checked' : '' %>> €500 tot €1K</label>
                <label class="chipToggle"><input type="checkbox" id="budget3" value="bedrag3" name="bedragen" <%= data.filters.bedragen.includes('bedrag3') ? 'checked' : '' %>> €1K tot €1.5K</label>
                <label class="chipToggle"><input type="checkbox" id="budget4" value="bedrag4" name="bedragen" <%= data.filters.bedragen.includes('bedrag4') ? 'checked' : '' %>> €1.5K tot €2.5K</label>
                <label class="chipToggle"><input type="checkbox" id="budget5" value="bedrag5" name="bedragen" <%= data.filters.bedragen.includes('bedrag5') ? 'checked' : '' %>> €2.5K tot €5K</label>
                <label class="chipToggle"><input type="checkbox" id="budget6" value="bedrag6" name="bedragen" <%= data.filters.bedragen.includes('bedrag6') ? 'checked' : '' %>> Meer dan €5K</label>
            </fieldset>

            <fieldset>
                <legend>Type verblijf</legend>
                <label class="chipToggle"><input type="checkbox" id="verblijf1" value="hotel" name="verblijf" <%= data.filters.verblijf.includes('hotel') ? 'checked' : '' %>> Hotel</label>
                <label class="chipToggle"><input type="checkbox" id="verblijf2" value="motel" name="verblijf" <%= data.filters.verblijf.includes('motel') ? 'checked' : '' %>> Motel</label>
                <label class="chipToggle"><input type="checkbox" id="verblijf3" value="b&b" name="verblijf" <%= data.filters.verblijf.includes('b&b') ? 'checked' : '' %>> B&B</label>
                <label class="chipToggle"><input type="checkbox" id="verblijf4" value="camper-caravan" name="verblijf" <%= data.filters.verblijf.includes('camper-caravan') ? 'checked' : '' %>> Camper/caravan</label>
                <label class="chipToggle"><input type="checkbox" id="verblijf5" value="tent" name="verblijf" <%= data.filters.verblijf.includes('tent') ? 'checked' : '' %>> Tent</label>
            </fieldset>

             <fieldset>
                <legend>Type reis</legend>
                <div class="chipToggle"><input type="checkbox" id="reis1" value="reis-optie1" name="reizen" <%= data.filters.reizen.includes('reis-optie1') ? 'checked' : '' %>> <label for="reis1">Rondreis</label></div>
                <div class="chipToggle"><input type="checkbox" id="reis2" value="reis-optie2" name="reizen" <%= data.filters.reizen.includes('reis-optie2') ? 'checked' : '' %>> <label for="reis2">Resort</label></div>
                <div class="chipToggle"><input type="checkbox" id="reis3" value="reis-optie3" name="reizen" <%= data.filters.reizen.includes('reis-optie3') ? 'checked' : '' %>> <label for="reis3">Wintersport</label></div>
                <div class="chipToggle"><input type="checkbox" id="reis4" value="reis-optie4" name="reizen" <%= data.filters.reizen.includes('reis-optie4') ? 'checked' : '' %>> <label for="reis4">Camping</label></div>
                <div class="chipToggle"><input type="checkbox" id="reis5" value="reis-optie5" name="reizen" <%= data.filters.reizen.includes('reis-optie5') ? 'checked' : '' %>> <label for="reis5">City trip</label></div>
                 <div class="chipToggle"><input type="checkbox" id="reis6" value="reis-optie6" name="reizen" <%= data.filters.reizen.includes('reis-optie6') ? 'checked' : '' %>> <label for="reis6">Safari</label></div>
            </fieldset>

            <fieldset>
                <legend>Aantal reizigers</legend>
                <label for="reizigersMin">Minimum</label>
                <input type="number" id="reizigersMin" name="reizigersMin" value="<%= data.filters.reizigersMin %>"> 
                <label for="reizigersMax">Maximum</label>
                <input type="number" id="reizigersMax" name="reizigersMax" value="<%= data.filters.reizigersMax %>">
            </fieldset>

            <input type="submit" value="Pas filters toe" class="button">
        </form>
    </section>
    <section class="matching-container">
        <div class="knop-boven">
            <% if (data.reizen && data.reizen.length > 0) { %>
                <button type="button" id="btn-accepteren" class="button button-save" data-id="<%= data.reizen[0]._id %>">
                    Accepteren
                </button>
            <% } %>
        </div>
    
        <ul class="reisKaartContainer">
           <% if (data.reizen && data.reizen.length > 0) { %>
               <% data.reizen.forEach(function (reis) { %>
                   <%- include("../partials/reiskaartGroot", { data: { reis: reis } }) %>
               <% }) %>
           <% } else { %>
               <li>Er is op dit moment geen reis beschikbaar.</li>
           <% } %>
        </ul>
            
        <div class="knop-onder">
            <% if (data.reizen && data.reizen.length > 0) { %>
                <button type="button" id="btn-afwijzen" class="button button-skip" data-id="<%= data.reizen[0]._id %>">
                    Afwijzen
                </button>
            <% } %>
        </div>
    </section>
</main>

<script src="/js/verwerkMatch.js"></script>