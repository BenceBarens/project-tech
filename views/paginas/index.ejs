<% layout('layouts/boilerplate') %>
<div class="homeDiv">
    <label for="filtersUitklappen">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M22 3H2L10 12.46V19L14 21V12.46L22 3Z" stroke="#31494B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Zoekfilters
    </label>
</div>

<main class="home" id="main">
    <section>
        <input type="checkbox" id="filtersUitklappen" name="Zoekfilters">
        <form method="GET" action="/">
            <!-- <fieldset>
                <legend>Bestemmingen</legend>
                <ul>
                    <li><button type="button">+</button></li>
                </ul>
            </fieldset> -->

            <fieldset>
                <legend>Budget range</legend>
                <div class="chipToggle"><input type="checkbox" id="budget1" value="bedrag1" name="bedragen"><label for="budget1">€0 tot €500</label></div>
                <div class="chipToggle"><input type="checkbox" id="budget2" value="bedrag2" name="bedragen"><label for="budget2">€500 tot €1K</label></div>
                <div class="chipToggle"><input type="checkbox" id="budget3" value="bedrag3" name="bedragen"><label for="budget3">€1K tot €1.5K</label></div>
                <div class="chipToggle"><input type="checkbox" id="budget4" value="bedrag4" name="bedragen"><label for="budget4">€1.5K tot €2.5K</label></div>
                <div class="chipToggle"><input type="checkbox" id="budget5" value="bedrag5" name="bedragen"><label for="budget5">€2.5K tot €5K</label></div>
                <div class="chipToggle"><input type="checkbox" id="budget6" value="bedrag6" name="bedragen"><label for="budget6">Meer dan €5K</label></div>
            </fieldset>
            <fieldset>
                <legend>Type verblijf</legend>
                <div class="chipToggle"><input type="checkbox" id="verblijf1" value="hotel" name="verblijf"><label for="verblijf1">Hotel</label></div>
                <div class="chipToggle"><input type="checkbox" id="verblijf2" value="motel" name="verblijf"><label for="verblijf2">Motel</label></div>
                <div class="chipToggle"><input type="checkbox" id="verblijf3" value="b&b" name="verblijf"><label for="verblijf3">B&B</label></div>
                <div class="chipToggle"><input type="checkbox" id="verblijf4" value="camper-caravan" name="verblijf"><label for="verblijf4">Camper/caravan</label></div>
                <div class="chipToggle"><input type="checkbox" id="verblijf5" value="tent" name="verblijf"><label for="verblijf5">Tent</label></div>
            </fieldset>
            <fieldset>
                <legend>Aantal reizigers</legend>
                <label for="reizigersMin">Minimum</label>
                <input type="number" id="reizigersMin" name="reizigersMin">
                <label for="reizigersMax">Maximum</label>
                <input type="number" id="reizigersMax" name="reizigersMax">
            </fieldset>
            <input type="submit" value="Pas filters toe">
        </form>
    </section>
    <section>
        <button class="button">Accepteren</button>
        <ul class="reisKaartContainer">
            <% if (data.reizen && data.reizen.length > 0) { %>
                <% data.reizen.forEach(function (reis) { %>
                <%- include("../partials/reiskaartGroot",  { data: { reis: reis } })  %>
            <% }) %>
            <% } else { %>
                <li>Er is op dit moment geen reis beschikbaar.</li>
            <% } %>
        </ul>
        <button class="button">Afwijzen</button>
    </section>
</main>