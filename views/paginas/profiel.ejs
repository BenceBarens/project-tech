		Feather Icons wordt verspreid onder de MIT-licentie-->
	</a>
</div>
<main class="profiel" id="main">

	<section class="profiel-header">
		<img src="<%= data.gebruiker.profielfoto %>" alt="Profielfoto van <%= data.gebruiker.voornaam %>">
		<h1><%= data.gebruiker.voornaam %> <span class="last-name"><%= data.gebruiker.achternaam %></span></h1>
		<p><%= data.gebruiker.bio %></p>
	</section>

	<section class="huidige-reizen">
		<h2>Huidige reizen</h2>

		<ul>
			<% if (data.gebruiker.reizen.length > 0) { %>
				<% data.gebruiker.reizen.forEach(function (reis) { %>
						<%- include("../partials/reiskaartKlein", { reis: reis }) %>
				<% }) %>
			<% } else { %>
				<p>Hier komen al jouw reizen te staan. <a href="/nieuwe-reis">Klik hier om er een aan te maken!</a></p>
			<% } %>
		</ul>
	</section>
</main>