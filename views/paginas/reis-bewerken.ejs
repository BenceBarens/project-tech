<% layout('layouts/boilerplate') %>
<div>
    <a href="/reis/<%= data.reis._id %>" class="button2">Annuleren</a>
</div>
<main id="main" class="reisBewerken">
    <h1>Reis bewerken</h1>

    <form method="POST">

        <!-- STAP 1 -->
        <fieldset>
            <legend>Basisinformatie</legend>

            <label for="reisTitel">Reistitel</label>
            <input type="text" id="reisTitel" name="reisTitel" value="<%= data.reis.reisTitel %>" required>

        </fieldset>

        <!-- STAP 2 -->
        <fieldset>
            <legend>Duur van de reis</legend>

            <label for="startDatum">Startdatum</label><br>
            <input type="date" id="startDatum" name="startDatum" value="<%= data.reis.startDatum %>" required><br>

            <label for="eindDatum">Einddatum</label><br>
            <input type="date" id="eindDatum" name="eindDatum" value="<%= data.reis.eindDatum %>" required><br>

            <label for="aantalDagen">Aantal dagen</label><br>
            <input type="number" id="aantalDagen" name="aantalDagen" value="<%= data.reis.aantalDagen %>" required>

        </fieldset>

        <!-- STAP 3 -->
        <fieldset>
            <legend>Beschrijving</legend>

            <label for="reis_samenvatting">Samenvatting</label>
            <input type="text" id="reis_samenvatting" name="reis_samenvatting" value="<%= data.reis.reis_samenvatting %>" required>

            <label for="reis_beschrijving">Beschrijving</label>
            <textarea id="reis_beschrijving" name="reis_beschrijving"><%= data.reis.reis_beschrijving %></textarea>

        </fieldset>

        <!-- STAP 4 -->
        <fieldset>
            <legend>Medereizigers</legend>

            Aantal reizigers<br>
            <label for="minReizigers">Minimum</label>
            <input type="number" id="minReizigers" name="minReizigers" value="<%= data.reis.minReizigers %>">

            <label for="maxReizigers">Maximum</label>
            <input type="number" id="maxReizigers" name="maxReizigers" value="<%= data.reis.maxReizigers %>">

            <br>Leeftijd medereizigers<br>
            <label for="minLeeftijd">Minimum</label>
            <input type="number" id="minLeeftijd" name="minLeeftijd" value="<%= data.reis.minLeeftijd %>">

            <label for="maxLeeftijd">Maximum</label>
            <input type="number" id="maxLeeftijd" name="maxLeeftijd" value="<%= data.reis.maxLeeftijd %>">

            <br>Geslacht<br>
            <label class="chipToggle"><input type="checkbox" id="vrouwen" name="geslacht" value="vrouwen" <%= data.reis.geslacht?.includes('vrouwen') ? 'selected' : '' %>>Vrouwen</label>
            <label class="chipToggle"><input type="checkbox" id="mannen" name="geslacht" value="mannen" <%= data.reis.geslacht?.includes('mannen') ? 'selected' : '' %>>Mannen</label>
            <label class="chipToggle"><input type="checkbox" id="anders" name="geslacht" value="anders" <%= data.reis.geslacht?.includes('anders') ? 'selected' : '' %>>Anders</label>

        </fieldset>

        <!-- STAP 5 -->
        <fieldset>
            <legend>Bestemmingen</legend>

            <label for="bestemmingen">Bestemmingen (komma gescheiden)</label>
            <input type="text" id="bestemmingen" name="bestemmingen" 
                value="<%= Array.isArray(data.reis.bestemmingen) ? data.reis.bestemmingen.join(', ') : data.reis.bestemmingen %>">

        </fieldset>

        <!-- STAP 6 -->
        <fieldset>
            <legend>Budget</legend>
            <label class="chipRadio"><input type="radio" id="bedrag1" name="bedragen" value="bedrag1" <%= data.reis.bedragen === 'bedrag1' ? 'checked' : '' %>>€0 tot €500</label>
            <label class="chipRadio"><input type="radio" id="bedrag2" name="bedragen" value="bedrag2" <%= data.reis.bedragen === 'bedrag2' ? 'checked' : '' %>>€500 tot €1K</label>
            <label class="chipRadio"><input type="radio" id="bedrag3" name="bedragen" value="bedrag3" <%= data.reis.bedragen === 'bedrag3' ? 'checked' : '' %>>€1K tot €1.5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag4" name="bedragen" value="bedrag4" <%= data.reis.bedragen === 'bedrag4' ? 'checked' : '' %>>€1.5K tot €2.5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag5" name="bedragen" value="bedrag5" <%= data.reis.bedragen === 'bedrag5' ? 'checked' : '' %>>€2.5K tot €5K</label>
            <label class="chipRadio"><input type="radio" id="bedrag6" name="bedragen" value="bedrag6" <%= data.reis.bedragen === 'bedrag6' ? 'checked' : '' %>>Meer dan €5K</label>
        </fieldset>

        <!-- STAP 7 -->
        <fieldset>
            <legend>Activiteiten</legend>

            <label class="chipToggle"><input type="checkbox" id="wandelen" name="activiteit" value="wandelen" <%= data.reis.activiteit?.includes('wandelen') ? 'checked' : '' %>>Wandelen</label>
            <label class="chipToggle"><input type="checkbox" id="fietsen" name="activiteit" value="fietsen" <%= data.reis.activiteit?.includes('fietsen') ? 'checked' : '' %>>Fietsen</label>
            <label class="chipToggle"><input type="checkbox" id="zwemmen" name="activiteit" value="zwemmen" <%= data.reis.activiteit?.includes('zwemmen') ? 'checked' : '' %>>Zwemmen</label>
            <label class="chipToggle"><input type="checkbox" id="museau-bezoeken" name="activiteit" value="musea bezoeken" <%= data.reis.activiteit?.includes('museau-bezoeken') ? 'checked' : '' %>>Musea bezoeken</label>
            <label class="chipToggle"><input type="checkbox" id="ontdekken" name="activiteit" value="ontdekken" <%= data.reis.activiteit?.includes('ontdekken') ? 'checked' : '' %>>Ontdekken</label>

        </fieldset>

        <!-- STAP 8 -->
        <fieldset>
            <legend>Type reis</legend>

            <label class="chipRadio"><input type="radio" id="reis-optie1" name="reizen" value="reis-optie1" <%= data.reis.reizen === 'reis-optie1' ? 'checked' : '' %> required oninvalid="this.setCustomValidity('Kies een van de opties voor het type reis.')" oninput="this.setCustomValidity('')">Rondreis (en overig)</label>
            <label class="chipRadio"><input type="radio" id="reis-optie2" name="reizen" value="reis-optie2" <%= data.reis.reizen === 'reis-optie2' ? 'checked' : '' %>>Resort</label>
            <label class="chipRadio"><input type="radio" id="reis-optie3" name="reizen" value="reis-optie3" <%= data.reis.reizen === 'reis-optie3' ? 'checked' : '' %>>Wintersport</label>
            <label class="chipRadio"><input type="radio" id="reis-optie4" name="reizen" value="reis-optie4" <%= data.reis.reizen === 'reis-optie4' ? 'checked' : '' %>>Camping</label>
            <label class="chipRadio"><input type="radio" id="reis-optie5" name="reizen" value="reis-optie5" <%= data.reis.reizen === 'reis-optie5' ? 'checked' : '' %>>City trip</label>
            <label class="chipRadio"><input type="radio" id="reis-optie6" name="reizen" value="reis-optie6" <%= data.reis.reizen === 'reis-optie6' ? 'checked' : '' %>>Safari</label>

        </fieldset>

        <!-- STAP 9 -->
        <fieldset>
            <legend>Verblijf</legend>

            <label class="chipToggle"><input type="checkbox" id="hotel" name="verblijf" value="hotel" <%= data.reis.verblijf?.includes('hotel') ? 'checked' : '' %>>Hotel</label>
            <label class="chipToggle"><input type="checkbox" id="motel" name="verblijf" value="motel" <%= data.reis.verblijf?.includes('motel') ? 'checked' : '' %>>Motel</label>
            <label class="chipToggle"><input type="checkbox" id="caravan/camper" name="verblijf" value="caravan/camper" <%= data.reis.verblijf?.includes('caravan/camper') ? 'checked' : '' %>>Caravan/camper</label>
            <label class="chipToggle"><input type="checkbox" id="b&b" name="verblijf" value="b&b" <%= data.reis.verblijf?.includes('b&b') ? 'checked' : '' %>>Bed & breakfast B&B</label>
            <label class="chipToggle"><input type="checkbox" id="tent" name="verblijf" value="tent" <%= data.reis.verblijf?.includes('tent') ? 'checked' : '' %>>Tent</label>

        </fieldset>

        <button type="submit" class="button">Wijzigingen opslaan</button>
        <a href="/reis/<%= data.reis._id %>" class="button2">Annuleren</a>

    </form>
</main>