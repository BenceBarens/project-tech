<% layout('layouts/boilerplate') %>
<div>
    <a href="/inloggen" class="button2">Inloggen</a>
</div>
<main id="main" class="registreren">
<h1>Nieuw account aanmaken</h1>
<p>Heeft u al een account? <a href="/inloggen">Log hier in.</a></p>

<form action="/registreren" method="POST" enctype="multipart/form-data">

<fieldset id="stap1">
    <legend>Basisgegevens (1/4)</legend>

        <div>
            <label for="voornaam">Voornaam</label>
            <input type="text" placeholder="Michael" id="voornaam" name="voornaam" required>
        </div>
        <div>
            <label for="achternaam">Achternaam</label>
            <input type="text" placeholder="Scott" id="achternaam" name="achternaam" required>
        </div>
        <div>
            <label for="email">Email</label>
            <input type="email" placeholder="m.scott@dundermifflin.com" id="email" name="email" required>
        </div>
        <div>
            <label for="wachtwoord">Wachtwoord</label>
            <div class="password-container">
                <input type="password" id="wachtwoord" name="wachtwoord" placeholder="Wachtwoord" required minlength="8">
                <button type="button" id="togglePassword" aria-label="Wachtwoord tonen">
                    <svg id="eye-open" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    <svg id="eye-closed" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
                </button>
            </div>
        </div>
        <div class="formNav">
            <a href="#stap2" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
        </div>
</fieldset>

<fieldset id="stap2">
        <legend>Persoonlijke info (2/4)</legend>
        <div>
            <label for="geboorteDatum">Geboortedatum</label>
            <input type="date" id="geboorteDatum" name="geboorteDatum" required oninvalid="this.setCustomValidity('Geef je geboortedatum op.')" oninput="this.setCustomValidity('')">
        </div>

        <div>
            <label for="geslacht">Geslacht</label>
            <select id="geslacht" name="geslacht" required>
                <option>Vrouw</option>
                <option>Man</option>
                <option>Anders</option>
            </select>
        </div>

        <div>
            <label for="woonplaats">Woonplaats</label>
            <input type="text" placeholder="Amsterdam" id="woonplaats" name="woonplaats">
        </div>

        <div>
            <label for="land">Land</label>
            <input type="text" placeholder="Nederland" id="land" name="land" required>
        </div>

        <div class="formNav">
            <a href="#stap1" role="button" tabindex="-1" class="button2">Vorige</a>
            <a href="#stap3" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
        </div>
    </fieldset>

    <fieldset id="stap3">
        <legend>Vul je profiel aan (3/4)</legend>

        <div>
            <label for="profielfoto">Profielfoto</label>
            <input type="file" accept="image/*" id="profielfoto" name="profielfoto">
        </div>

        <div>
            <label for="bio">Bio</label>
            <textarea placeholder="Vertel wat leuks over jou zelf!" id="bio" name="bio"></textarea>
        </div>

        <div class="formNav">
            <a href="#stap2" role="button" tabindex="-1" class="button2">Vorige</a>
            <a href="#stap4" role="button" tabindex="-1" class="button btn-volgende">Volgende</a>
        </div>
    </fieldset>

    <fieldset id="stap4">
        <legend>Persoonlijke eigenschappen (4/4)</legend>

        <div>
            <label for="eigenschap1">Voorzichtig - Avontuurlijk</label>
            <input type="range" min="0" max="100" id="eigenschap1" name="eigenschap1">
        </div>
        <div>
            <label for="eigenschap2">Gepland gedrag - Spontaan</label>
            <input type="range" min="0" max="100" id="eigenschap2" name="eigenschap2">
        </div>
        <div>
            <label for="eigenschap3">Inactief - Actief</label>
            <input type="range" min="0" max="100" id="eigenschap3" name="eigenschap3">
        </div>
        <div>
            <label for="eigenshap4">Geen culturele interesses - Interesses</label>
            <input type="range" min="0" max="100" id="eigenschap4" name="eigenschap4">
        </div>
        <div>
            <label for="eigenschap5">Niet prikkelbaar - Prikkelbaar</label>
            <input type="range" min="0" max="100" id="eigenschap5" name="eigenschap5">
        </div>
        <div class="formNav">
            <a href="#stap3" role="button" tabindex="-1" class="button2">Vorige</a>
            <button type="submit" class="button btn-volgende">Afronden</button>
        </div>
    </fieldset>

</form>
</main>

<script src="/js/tonen.js"></script>
<script src="/js/foutmeldingen.js"></script>