<% layout('layouts/boilerplate') %>

<main>
<form action="/registreren" method="POST" enctype="multipart/form-data">

<!-- STAP 1 -->
<fieldset>
    <legend>Account aanmaken</legend>

    <label>Profielfoto</label>
    <input type="file" name="profielfoto">

    <label>gebruikersnaam*</label>
    <input type="text" name="voornaam" required>

    <label>Geboortedatum*</label>
    <input type="date" name="geboorteDatum">

    <label>Email*</label>
    <input type="email" name="email" required>

    <label>Wachtwoord*</label>
    <input type="password" name="wachtwoord" required>

    <!-- Verder / Terug buttons (zonder submit) -->
    <button type="button">Verder</button>
</fieldset>

<!-- STAP 2 -->
<fieldset>
    <legend>Profiel</legend>

    <label>Land*</label>
    <input type="text" name="land" required>

    <label>Woonplaats</label>
    <input type="text" name="woonplaats">

    <label>Geslacht*</label>
    <select name="geslacht" required>
        <option>Man</option>
        <option>Vrouw</option>
        <option>Anders</option>
    </select>

    <label>Bio</label>
    <textarea name="bio"></textarea>

    <!-- Verder / Terug buttons (zonder submit) -->
    <button type="button">Terug</button>
    <button type="button">Verder</button>
</fieldset>

<!-- STAP 3 -->
<fieldset>
    <legend>Eigenschappen</legend>

    <label>Avontuurlijk</label>
    <input type="range" min="0" max="100" name="eigenschap1">

    <label>Spontaan</label>
    <input type="range" min="0" max="100" name="eigenschap2">

    <label>Actief</label>
    <input type="range" min="0" max="100" name="eigenschap3">

    <label>Cultureel</label>
    <input type="range" min="0" max="100" name="eigenschap4">

    <label>Prikkelbaar</label>
    <input type="range" min="0" max="100" name="eigenschap5">

    <!-- Overslaan button -->

    <!-- Afronden button -->
    <button type="submit">Afronden</button>
</fieldset>

</form>
</main>