<% layout('layouts/boilerplate') %>

<main class="profiel" id="main">
    <section>
        <img src="<%= data.gebruiker.profielfoto %>" alt="Profielfoto">
        <div>
            <h1><%= data.gebruiker.voornaam %> <%= data.gebruiker.achternaam %></h1>
            <p><%= data.gebruiker.bio %></p>
        </div>
    </section>

    <section>
        <h2>Reizen van <%= data.gebruiker.voornaam %></h2>
        <ul>
            <% if (data.gebruiker.reizen.length > 0) { %>
                <% data.gebruiker.reizen.forEach(function (reis) { %>
                    <%- include("../partials/reiskaartKlein", { reis: reis }) %>
                <% }) %>
            <% } else { %>
                <p><%= data.gebruiker.voornaam %> heeft nog geen reizen aangemaakt.</p>
            <% } %>
        </ul>
    </section>

    <section>
		<h2>Deelnemende reizen</h2>
		<ul>
			<% if (data.gebruiker.deelnemendeReizen && data.gebruiker.deelnemendeReizen.length > 0) { %>
				<% data.gebruiker.deelenemendeReizen.forEach(function (reis) { %>
						<%- include("../partials/reiskaartKlein", { reis: reis }) %>
				<% }) %>
			<% } else { %>
				<p><%= data.gebruiker.voornaam %> neemt nog niet deel aan reizen.</p>
			<% } %>
		</ul>
	</section>
</main>