<% layout('layouts/boilerplate') %>
<div>
    <% if (data.isEigenaar) { %>
        <a href="/reis-bewerken/<%= data.reis._id %>" class="button2" id="bewerkReis">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/>
                <path d="M20.71 7.04a1.003 1.003 0 000-1.42L18.37 3.29a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.83z"/>
            </svg>
            Bewerken
        </a>
    <% } %>
</div>
<main id="main" class="reisDetail">
    <img src="../uploads/coverfoto/<%= data.reis.fotoPad %>" alt="Foto van <%= data.reis.titel %>">
    <div class="reiskaartInhoud">
        <h1><%= data.reis.reisTitel %></h1>
        <ul class="chipsInfo">
            <li>€<%= data.reis.bedragen %></li>
            <li><%= data.reis.minLeeftijd %> tot <%= data.reis.maxLeeftijd %> jaar oud</li>
        </ul>
        
        <p>
            Tussen 
            <b><time datetime="<%= data.reis.startDatum %>">
                <%= new Date(data.reis.startDatum).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </time></b>
            en 
            <b><time datetime="<%= data.reis.eindDatum %>">
                <%= new Date(data.reis.eindDatum).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </time></b>
            voor een periode van <b><%= data.reis.aantalDagen %></b> dagen.
        </p>
        
        <p><%= data.reis.reis_samenvatting %></p>

        <h3>Bestemming(en)</h3>
        <ul class="chipsInfo">
            <% if (data.reis.bestemmingen) { %>
                <% if (Array.isArray(data.reis.bestemmingen)) { %>
                    <% data.reis.bestemmingen.forEach(function(bestemming) { %>
                        <li><%= bestemming %></li>
                    <% }) %>
                <% } else { %>
                    <li><%= data.reis.bestemmingen %></li>
                <% } %>
            <% } else { %>
                <li>Geen bestemmingen opgegeven</li>
            <% } %>
        </ul>

        <h3>Activiteiten</h3>
        <ul class="chipsInfo">
            <% if (data.reis.activiteit) { %>
                <% if (Array.isArray(data.reis.activiteit)) { %>
                    <% data.reis.activiteit.forEach(function(act) { %>
                        <li><%= act %></li>
                    <% }) %>
                <% } else { %>
                    <li><%= data.reis.activiteit %></li>
                <% } %>
            <% } else { %>
                <li>Geen activiteiten opgegeven</li>
            <% } %>
        </ul>

        <h3>Verblijf</h3>
        <ul class="chipsInfo">
            <% if (data.reis.verblijf) { %>
                <% if (Array.isArray(data.reis.verblijf)) { %>
                    <% data.reis.verblijf.forEach(function(v) { %>
                        <li><%= v %></li>
                    <% }) %>
                <% } else { %>
                    <li><%= data.reis.verblijf %></li>
                <% } %>
            <% } else { %>
                <li>Geen verblijfstype opgegeven</li>
            <% } %>
        </ul>

        <h3>Reizigers</h3>
        <p>Capaciteit: <%= data.reis.minReizigers %> - <%= data.reis.maxReizigers %> personen</p>
        <% if (data.reis.reizigers) { %>
            <ul>
                <% if (Array.isArray(data.reis.reizigers)) { %>
                    <% data.reis.reizigers.forEach(function(reiziger) { %>
                        <li><%= reiziger %></li>
                    <% }) %>
                <% } else { %>
                    <li><%= data.reis.reizigers %></li>
                <% } %>
            </ul>
        <% } %>

        <h3>Beschrijving</h3>
        <p style="white-space: pre-line;"><%= data.reis.reis_beschrijving %></p>
    </div>
</main>