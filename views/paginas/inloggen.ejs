<% layout('layouts/boilerplate') %>
<div>
    <a href="#">Nog geen account?</a>
</div>

<main id="main" class="inloggen">
  <h1>Welkom terug!</h1>
  <p>Nog geen account? <a href="/registreren">Registreer hier.</a></p>

  <form action="/inloggen" method="post">
    <label for="email">E-mail</label>
    <input type="email" id="email" name="email">

    <label for="password">Wachtwoord</label>
    <input type="password" placeholder="Wachtwoord" id="tonen" name="wachtwoord" required><br><br>
    <input type="checkbox" onclick="wachtwoordTonen()">Wachtwoord tonen

    <input type="submit" value="Inloggen" class="button">
  </form>    
</main>

<script>
  function wachtwoordTonen() {
  var x = document.getElementById("tonen");
  if (x.type === "password") {
    x.type = "text";
  } else {
    x.type = "password";
  }
}
</script>