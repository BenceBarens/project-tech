<% layout('layouts/boilerplate') %>

<main class="instellingen">
  <a href="/profiel" class="annuleer-knop" aria-label="Ga terug naar profiel">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <!--Bron: Feather Icons. (z.d.). X icon. Geraadpleegd op 23 maart 2026, van https://feathericons.com/?query=x-->
  </a>

  <section class="instellingen-header">
    <h1>Instellingen</h1>

    <div class="profielfoto-edit">
      <img
        src="<%= data.gebruiker.profielfoto %>"
        alt="Profielfoto van <%= data.gebruiker.naam %>"
      />
      <button type="button" aria-label="Profielfoto wijzigen">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"
          ></path>
          <circle cx="12" cy="13" r="4"></circle>
        </svg>
        <!--Bron: Feather Icons. (z.d.). Camera icon. Geraadpleegd op 23 maart 2026, van https://feathericons.com/?query=camera-->
      </button>
    </div>
  </section>

  <form class="instellingen-form" action="/instellingen" method="post">
    <fieldset>
      <legend>Profiel</legend>

      <label for="naam">Naam</label>
      <input
        type="text"
        id="naam"
        name="naam"
        value="<%= data.gebruiker.naam %>"
      />

      <label for="vakgebied">Vakgebied</label>
      <input
        type="text"
        id="vakgebied"
        name="vakgebied"
        value="<%= data.gebruiker.vakgebied %>"
      />

      <label for="bio">Bio</label>
      <textarea id="bio" name="bio"><%= data.gebruiker.bio %></textarea>
    </fieldset>

    <fieldset>
      <legend>Account</legend>
      <label for="email">E-mailadres</label>
      <input
        type="email"
        id="email"
        name="email"
        value="<%= data.gebruiker.email %>"
      />

      <label for="wachtwoord">Nieuw wachtwoord</label>
      <input type="password" id="wachtwoord" name="wachtwoord" />
    </fieldset>
    <button type="submit">Opslaan</button>
  </form>

  <form action="/uitloggen" method="post">
    <button type="submit">Uitloggen</button>
  </form>
</main>
